<div class="card" style="width: 18rem;">
    @if (SelectedDish != null)
    {
        <img src="@SelectedDish.Image" class="card-img-top" alt="@SelectedDish.Name">
        <div class="card-body">
            <h5 class="card-title">@SelectedDish.Name</h5>
            <p class="card-text">@SelectedDish.Description</p>
            <span class="badge bg-secondary">@SelectedDish.Calories калорий</span>
        </div>
    }
</div>

@code {
    [Parameter]
    public Dish? SelectedDish { get; set; }
}
